# Optional local build config for the w64devkit GNU toolchain.
#
# MSVC needs none of this: on a standard Windows Rust install (host toolchain
# x86_64-pc-windows-msvc) `cargo build` works with no `.cargo/config.toml`.
# To build with w64devkit instead, copy this file to `.cargo/config.toml` (it is
# gitignored) and replace `C:/path/to/w64devkit` with your install directory.
# Never "fix" a missing `ld` or `dlltool` by adding w64devkit to the global PATH.
#
# Why these settings: `gcc.exe` is the linker driver, but its helper tools
# (`ld`, `dlltool`) live in the same bin dir which is NOT on PATH. Make the build
# self-contained (no PATH dependency) without relying on rustflags reaching host
# build scripts (they don't, when `target` is set explicitly):
#   * COMPILER_PATH (env, applies to every gcc invocation incl. build scripts) →
#     gcc's collect2 finds `ld`.
#   * -Cdlltool=... → the dlltool rustc uses to build Windows import libraries.
[build]
target = "x86_64-pc-windows-gnu"
rustflags = ["-Cdlltool=C:/path/to/w64devkit/bin/dlltool.exe"]
# Optional: a shared, absolute target dir so several worktrees of this repo
# reuse one build cache (the dependency tree compiles once, not per worktree).
# Keep it outside any worktree.
# target-dir = "C:/path/to/zicade-target"

[target.x86_64-pc-windows-gnu]
linker = "C:/path/to/w64devkit/bin/gcc.exe"

[env]
COMPILER_PATH = "C:/path/to/w64devkit/bin"
